# Linux Hitokoto library service
# Copy this file to .env and edit the values.
#
# Bind list, comma-separated. The default is dual-stack loopback:
#   127.0.0.1  IPv4 loopback
#   ::1        IPv6 loopback (skipped with a warning if the host has no ::1)
#
# Other examples:
#   HITOKOTO_HOST=127.0.0.1        IPv4 loopback only
#   HITOKOTO_HOST=::               dual-stack wildcard (public; use a firewall!)
#   HITOKOTO_HOST=0.0.0.0,::1      IPv4 wildcard + IPv6 loopback
#
# The same port must appear in:
#   - this file (HITOKOTO_PORT)
#   - nginx/yiyan.overpass.top.conf (upstream server)
#   - the systemd unit's EnvironmentFile (it reads this file)

HITOKOTO_HOST=127.0.0.1,::1
HITOKOTO_PORT=13469
HITOKOTO_DATA_FILE=/opt/hitokoto-server/data/quotes.json
HITOKOTO_LOG_LEVEL=info

# Public origin used in the generated single-file Custom.xaml.
# Do not add a trailing slash.
HITOKOTO_PUBLIC_BASE_URL=https://yiyan.overpass.top

# Leave empty to disable POST /api/quotes and /api/quotes/bulk.
# To enable writing, generate a long random token, for example:
#   openssl rand -hex 32
HITOKOTO_ADMIN_TOKEN=
