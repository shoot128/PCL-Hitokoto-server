# Linux Hitokoto library service
# Copy this file to .env and edit the values.
#
# The service listens on 127.0.0.1:13469.
# The same port must appear in:
#   - this file (HITOKOTO_PORT)
#   - nginx/overpass.top.conf (upstream server)
#   - the systemd unit's EnvironmentFile (it reads this file)

HITOKOTO_HOST=127.0.0.1
HITOKOTO_PORT=13469
HITOKOTO_DATA_FILE=/opt/hitokoto-server/data/quotes.json
HITOKOTO_LOG_LEVEL=info

# Leave empty to disable POST /api/quotes and /api/quotes/bulk.
# To enable writing, generate a long random token, for example:
#   openssl rand -hex 32
HITOKOTO_ADMIN_TOKEN=
