<!--
    PCL 一言主页 · 单文件联网版
    ==================================================================
    这个 XAML 由服务端在每次请求时生成：一言正文、出处、作者、句库
    数量和生成时间已经写入页面，PCL 只需要下载 Custom.xaml 一个文件，
    不再依赖 PowerShell、VBS 或本地 Hitokoto 文件夹。

    动态更新链接（PCL 会同时请求 Custom.xaml.ini 检查版本）：
      https://你的域名/Custom.xaml
     PCL CE 不会替换网址里的花括号标记；页面搜索时先由“搜索”按钮通过
     “修改设置”把本机 UiCustomNet 改成带 ?q= 的地址，再点“刷新结果”
     下载。每个 PCL 各自保存自己的地址，服务端不保存“上一个用户搜了什么”。
-->

<StackPanel.Resources>
    <Style x:Key="HitokotoQuoteText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="30" />
    </Style>
</StackPanel.Resources>

<local:MyCard Title="一言 · Hitokoto" Margin="0,0,0,15">
    <StackPanel Margin="25,40,23,15">
        <TextBlock x:Name="QuoteText"
                   FontSize="19"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource ColorBrush1}"
                   Style="{StaticResource HitokotoQuoteText}">
            <TextBlock.Text>__QUOTE__</TextBlock.Text>
        </TextBlock>

        <TextBlock FontSize="13"
                   Margin="0,0,0,4"
                   Foreground="#666666">
            <TextBlock.Text>__META__</TextBlock.Text>
        </TextBlock>

        <TextBlock FontSize="12"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ColorBrush2}">
            <TextBlock.Text>__STATUS__</TextBlock.Text>
        </TextBlock>

        <TextBlock FontSize="11"
                   Margin="0,0,0,10"
                   Foreground="#888888"
                   TextWrapping="Wrap">
            <TextBlock.Text>__INFO__</TextBlock.Text>
        </TextBlock>

        <WrapPanel Margin="0,4,0,0">
            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="18,0,18,0"
                            ColorType="Highlight"
                            Text="换一句"
                            ToolTip="__REFRESH_TOOLTIP__"
                            EventType="刷新主页"
                            EventData="-">
                __REFRESH_EVENTS_BLOCK__
            </local:MyButton>

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="复制这句话"
                            ToolTip="把当前显示的一言复制到剪贴板"
                            EventType="复制文本"
                            EventData="{Binding Text, ElementName=QuoteText}" />

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="刷新显示"
                            ToolTip="只重新读取当前页面，不会重新下载；要换一句请点“换一句”。"
                            EventType="刷新页面" />

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="打开一言 API"
                            ToolTip="在浏览器中打开一言 API"
                            EventType="打开网页"
                            EventData="https://v1.hitokoto.cn/" />
        </WrapPanel>

    </StackPanel>
</local:MyCard>

__SEARCH_CARD__

